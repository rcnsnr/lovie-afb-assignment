# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# PostgreSQL connection string — via Supabase connection pooler (Transaction mode).
# Supabase: Settings → Database → Connection string → URI (use "Transaction" pooler port 6543)
# Required query params for serverless (Vercel): ?pgbouncer=true&connect_timeout=10
# This is the runtime URL used by the deployed app and can also be used locally for trusted dev flows.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connect_timeout=10"

# Direct (non-pooled) connection — local-only, used by Prisma migrations / seed commands from a trusted shell.
# Supabase: Settings → Database → Connection string → URI (use "Session" mode port 5432)
# Never include pgbouncer params here. Do not store this in Vercel by default.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# iron-session cookie secret — must be at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-characters"

# Base URL used by Playwright E2E tests.
# Leave as-is for local dev; set to your Vercel preview URL for CI.
BASE_URL="http://localhost:3000"
