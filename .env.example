# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# PostgreSQL connection string.
# For Supabase: Settings → Database → Connection string → URI
# Append ?pgbouncer=true&connect_timeout=10 for Vercel serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true&connect_timeout=10"

# iron-session cookie secret — must be at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-characters"

# Base URL used by Playwright E2E tests.
# Leave as-is for local dev; set to your Vercel preview URL for CI.
BASE_URL="http://localhost:3000"
